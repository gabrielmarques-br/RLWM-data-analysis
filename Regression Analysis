# Exploratory regressions (not preregistered): Section 3.6 and Figure 5
# Marques et al. (2026) - preregistration: https://osf.io/qh4c6
# All variables standardized, so slopes are standardized betas.

library(ggplot2)

# Data (not included, see README) ---------------------------------------------
dat <- read.csv("data.csv", check.names = FALSE)
names(dat) <- gsub("-", "_", names(dat))
params <- c("learning_rate", "pers", "eta3_wm", "eta6_wm")
dat[params] <- lapply(dat[params], function(x) as.numeric(gsub(",", ".", x)))
stopifnot(nrow(dat) == 110)  # participants above the 75% task cut-off

predictors <- c(FS_BAS_CW = "Fun Seeking (BIS/BAS)",
                RR_BAS_PQ = "Reward Reactivity (RST-PQ)",
                RI_BAS_PQ = "Reward Interest (RST-PQ)")
outcomes   <- c(learning_rate = "RL+ (learning rate)",
                pers          = "RL- (persistence)")

z <- as.data.frame(lapply(dat[c(names(predictors), names(outcomes))],
                          function(x) as.numeric(scale(x))))

results <- do.call(rbind, lapply(names(outcomes), function(y) {
  do.call(rbind, lapply(names(predictors), function(x) {
    co <- coef(summary(lm(reformulate(x, y), data = z)))[x, ]
    data.frame(predictor = predictors[[x]], outcome = outcomes[[y]],
               beta = co[[1]], se = co[[2]], p = co[[4]])
  }))
}))
results$sig <- ifelse(results$p < .001, "***", ifelse(results$p < .01, "**",
               ifelse(results$p < .05, "*", "")))
print(results, digits = 3)

# Figure 5 - standardized betas +/- 1 SE --------------------------------------
results$predictor <- factor(results$predictor, levels = predictors,
                            labels = sub(" (", "\n(", predictors, fixed = TRUE))
dodge <- position_dodge(width = 0.4)

fig5 <- ggplot(results, aes(predictor, beta, color = outcome)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
  geom_errorbar(aes(ymin = beta - se, ymax = beta + se),
                width = 0.1, position = dodge) +
  geom_point(size = 4, position = dodge) +
  geom_text(aes(y = beta + se + 0.02, label = sig),
            position = dodge, size = 5, show.legend = FALSE) +
  scale_color_manual(values = c("#5B9BD5", "#C957A0")) +
  labs(x = NULL, y = expression(beta ~ "(" %+-% "SE)"), color = NULL) +
  theme_classic(base_size = 13) +
  theme(legend.position = "top")

ggsave("figure5.png", fig5, width = 7, height = 5, dpi = 300)
